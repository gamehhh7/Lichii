@@ -300,6 +303,34 @@ json ReadFrameTimes(u64 before, u64 after, u64 begin_ns, u64 end_ns, double refr
             {"truncated", truncated}};
 }
 
+json ReadFrameTimeHistory(u64 present_count) {
+    const u64 capacity = g_nx2_present_times_ns.size();
+    const u64 last = present_count == 0 ? 0 : present_count - 1;
+    const u64 first = last > capacity ? last - capacity + 1 : u64{1};
+    bool truncated = false;
+    const bool ring_wrapped = first > 1;
+    json timestamps = json::array();
+    u64 previous_timestamp = 0;
+    for (u64 frame = first; frame <= last && frame != 0; ++frame) {
+        const u64 timestamp =
+            g_nx2_present_times_ns[frame % capacity].load(std::memory_order_relaxed);
+        if (timestamp == 0 || (previous_timestamp != 0 && timestamp <= previous_timestamp)) {
+            truncated = true;
+            previous_timestamp = 0;
+            continue;
+        }
+        timestamps.push_back({{"present", frame}, {"timestamp_ns", timestamp}});
+        previous_timestamp = timestamp;
+    }
+    return {
+        {"present_count", present_count},
+        {"first_present", timestamps.empty() ? u64{0} : timestamps.front()["present"].get<u64>()},
+        {"last_present", timestamps.empty() ? u64{0} : timestamps.back()["present"].get<u64>()},
+        {"timestamps_ns", std::move(timestamps)},
+        {"ring_wrapped", ring_wrapped},
+        {"truncated", truncated}};
+}
