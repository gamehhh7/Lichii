+TEST_CASE("Debug frame time history returns a raw ring snapshot", "[core][nx2_debug_server]") {
+    auto& ring = Core::g_nx2_present_times_ns;
+    SCOPE_EXIT {
+        for (auto& timestamp : ring) {
+            timestamp.store(0);
+        }
+    };
+    for (auto& timestamp : ring) {
+        timestamp.store(0);
+    }
+    const auto empty = Core::Nx2Debug::ReadFrameTimeHistory(0);
+    REQUIRE(empty["timestamps_ns"].empty());
+    REQUIRE(empty["ring_wrapped"] == false);
+    REQUIRE(empty["truncated"] == false);
+    ring[1] = 1'000;
+    ring[2] = 17'667;
+    ring[3] = 51'001;
+
+    // The highest count may not have stored its timestamp yet, so it is excluded.
+    const auto history = Core::Nx2Debug::ReadFrameTimeHistory(4);
+    REQUIRE(history["present_count"] == 4);
+    REQUIRE(history["first_present"] == 1);
+    REQUIRE(history["last_present"] == 3);
+    REQUIRE(history["timestamps_ns"] == json::array({
+                                            json{{"present", 1}, {"timestamp_ns", 1'000}},
+                                            json{{"present", 2}, {"timestamp_ns", 17'667}},
+                                            json{{"present", 3}, {"timestamp_ns", 51'001}},
+                                        }));
+    REQUIRE(history["ring_wrapped"] == false);
+    REQUIRE(history["truncated"] == false);
+
+    const u64 count = ring.size() + 5;
+    for (u64 frame = 5; frame < count; ++frame) {
+        ring[frame % ring.size()] = frame * 1'000;
+    }
+    const auto overflow = Core::Nx2Debug::ReadFrameTimeHistory(count);
+    REQUIRE(overflow["timestamps_ns"].size() == ring.size());
+    REQUIRE(overflow["first_present"] == 5);
+    REQUIRE(overflow["last_present"] == count - 1);
+    REQUIRE(overflow["ring_wrapped"] == true);
+    REQUIRE(overflow["truncated"] == false);
+
+    for (auto& timestamp : ring) {
+        timestamp.store(0);
+    }
+    ring[1] = 1'000;
+    ring[2] = 2'000;
+    ring[4] = 4'000;
+    const auto gap = Core::Nx2Debug::ReadFrameTimeHistory(5);
+    REQUIRE(gap["truncated"] == true);
+    REQUIRE(gap["timestamps_ns"].size() == 3);
+    REQUIRE(gap["timestamps_ns"][2]["present"] == 4);
+
+    ring[3] = 3'000;
+    ring[4] = 2'500;
+    const auto nonmonotonic = Core::Nx2Debug::ReadFrameTimeHistory(5);
+    REQUIRE(nonmonotonic["truncated"] == true);
+    REQUIRE(nonmonotonic["timestamps_ns"].size() == 3);
+    REQUIRE(nonmonotonic["last_present"] == 3);
+}
